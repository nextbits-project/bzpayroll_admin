<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt"%>
<%@taglib uri="http://www.springframework.org/tags/form" prefix="form"%>
<%@taglib uri="http://www.springframework.org/tags" prefix="spring"%>
<%@ page import="java.util.*, java.io.*"%>
<%@ page isELIgnored="false"%>
<%--<%@ page errorPage="/WEB-INF/jsp/include/sessionExpired.jsp"%>--%>
<html>
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<%@include file="/WEB-INF/jsp/include/headlogo.jsp"%>
	<%@include file="/WEB-INF/jsp/include/header.jsp"%>
	<%@include file="/WEB-INF/jsp/include/menu.jsp"%>
	<title><spring:message code="BzComposer.hiredemployeelisttitle"/>
	</title>
	<link href="${pageContext.request.contextPath}/tableStyle/tab/jquery-ui-tab.css" rel="stylesheet" media="screen" />
 	<script src="${pageContext.request.contextPath}/tableStyle/tab/jquery-ui.js"></script>
	<!-- Custom styling to match customer list design -->
	<style>
		/* Customer list table styling */
		.tabla-listados {
			border-collapse: collapse !important;
			width: 100% !important;
			margin-top: 10px !important;
		}
		.tabla-listados th {
			background-color: #f2f2f2 !important;
			padding: 8px !important;
			text-align: left !important;
			border-bottom: 1px solid #ddd !important;
			font-weight: normal !important;
		}
		.tabla-listados td {
			padding: 8px !important;
			text-align: left !important;
			border-bottom: 1px solid #ddd !important;
		}
		.tabla-listados tr:hover {
			background-color: #f5f5f5 !important;
		}
		.draft, .row-employee.draft {
			background-color: #f0f0f0 !important;
		}
		/* Button styling to match image */
		.formButton {
			background-color: #1E90FF !important;
			color: white !important;
			border: none !important;
			padding: 5px 15px !important;
			margin-right: 5px !important;
			cursor: pointer !important;
			border-radius: 3px !important;
		}
		/* Search box styling */
		#myInput {
			padding: 5px !important;
			border: 1px solid #ccc !important;
			border-radius: 3px !important;
			width: 200px !important;
		}
		/* Styling to match customer list in image */
		table.customer-table {
			border-collapse: collapse !important;
			width: 100% !important;
		}
		.customer-table th {
			background-color: #f2f2f2 !important;
			padding: 8px !important;
			text-align: left !important;
			border-bottom: 1px solid #ddd !important;
			font-weight: normal !important;
		}
		.customer-table td {
			padding: 8px !important;
			text-align: left !important;
			border-bottom: 1px solid #ddd !important;
		}
		.customer-table tr:hover {
			background-color: #f5f5f5 !important;
		}
		/* Action buttons styling like in image */
		.action-button {
			background-color: #1E90FF !important;
			color: white !important;
			border: none !important;
			padding: 5px 15px !important;
			margin-right: 5px !important;
			cursor: pointer !important;
		}
		.action-button.delete {
			background-color: #DC3545 !important;
		}
		/* Additional styling to match image */
		.row-employee {
			cursor: pointer !important;
		}
		.row-employee:nth-child(even) {
			background-color: #f9f9f9 !important;
		}
	</style>
    <script>
		$(document).ready(function(){
			// Hide employee details section on page load
			$("#employee-details").hide();
			
			$("#myInput").on("keyup", function() {
				var value = $(this).val().toLowerCase();
				$("#custTableBody tr").filter(function() {
					$(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
				});
			});
			
			// Select all checkboxes
			$("#selectAll").click(function() {
				$('input[name="employeeSelect"]').prop('checked', this.checked);
			});
			
			// When checkbox is clicked, don't trigger the row click event
			$('input[name="employeeSelect"]').click(function(e) {
				e.stopPropagation();
			});
		});
	</script>
	
	<style>
		.customer-table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 10px;
		}
		.customer-table th {
			padding: 8px;
			text-align: left;
			border-bottom: 1px solid #ddd;
			background-color: #f2f2f2;
			position: sticky;
			top: 0;
			z-index: 10;
		}
		.customer-table td {
			padding: 8px;
			text-align: left;
			border-bottom: 1px solid #ddd;
		}
		.customer-table tr:hover {
			background-color: #f5f5f5;
		}
		.selected-row {
			background-color: #f0f0f0 !important;
		}
		.search-box {
			padding: 5px;
			border: 1px solid #ccc;
			border-radius: 3px;
			margin-bottom: 10px;
			width: 200px;
		}
		.action-buttons {
			margin-bottom: 15px;
		}
		.action-buttons button {
			margin-right: 10px;
			padding: 5px 15px;
			border: none;
			cursor: pointer;
		}
		.btn-primary {
			background-color: #1E90FF;
			color: white;
		}
		.btn-danger {
			background-color: #DC3545;
			color: white;
		}
	</style>
	<script>
		$(function() {
			$('#sortBy').change(function(){
			    loadEmployeeList();

			});
		});
	</script>

	<script>

	 $(document).ready(function() {
	    $('#chkHired').change(function() {
            loadEmployeeList();
        });
        $('#chkTerminated').change(function() {
            loadEmployeeList();
         });


       });


       function loadEmployeeList(){
            var sortBy = $('#sortBy').val();
            var hired = $('#chkHired').is(":checked");
            var terminated = $('#chkTerminated').is(":checked");
            var tabId = '';
            if(hired && terminated){
                tabId = 'loadAll';
            }else if(terminated){
                tabId = 'loadTerminated';
            }else if(hired){
                tabId = 'loadHired';
            }



            $.ajax({  type: "POST",
            					url:"EmployeeAjax?tabid="+tabId+"&sortBy="+sortBy,
            					data:{sortBy:sortBy},
            				}).done(function(data){
            					$('#custTableBody').html('');
            					var custDetails = "";
            					for(var i=0; i<data.length; i++){
             						var objList = data[i];
            						var td = "";

            						custDetails = custDetails +"<input type='hidden' name='listSize' id='lSize' value='"+data.length+"'>" +
            								"<tr id='"+i+"$$' class='row-employee' onmouseover='setRowId(this,"+objList.employeeID+","+i+")'>" +
            								"<td colspan='2' style='font-size: 14px; width: 300px;'>"+
            								objList.fname+" "+objList.lname+
            								"</td>"+
            								"</tr>";
            					}
            					$('#custTableBody').html(custDetails);
            				});
        }

	</script>
</head>
<body onload="initialize();">
